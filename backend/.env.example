# Product Demand Prediction Environment Configuration
# Copy this file to .env and adjust variables as needed.

# ==========================================
# Cloud AI Provider: Google Gemini (Recommended for cloud/serverless)
# ==========================================
# To enable Gemini API, set your API key here:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Local AI Provider: Ollama (Recommended for offline local usage)
# ==========================================
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b

# If neither Gemini nor Ollama is configured or reachable, DemandIQ will
# automatically and seamlessly use its deterministic Analytics & Forecasting Rule Engine,
# generating factual, data-grounded insights without any crashing or external dependency.
